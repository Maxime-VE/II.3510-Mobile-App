<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- TextView original -->
    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Demo Application !"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="16dp"/>


    <TextView
        android:id="@+id/permission_media"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Permission Media"
        app:layout_constraintBottom_toTopOf="@+id/permission_record_audio"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView"
        android:layout_marginTop="20dp"/>

    <TextView
        android:id="@+id/permission_record_audio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Permission Record Audio"
        app:layout_constraintBottom_toTopOf="@+id/permission_contact"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/permission_media"
        android:layout_marginTop="5dp"/>

    <TextView
        android:id="@+id/permission_contact"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Permission Contact"
        app:layout_constraintBottom_toTopOf="@+id/permission_location"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/permission_record_audio"
        android:layout_marginTop="5dp"/>

    <TextView
        android:id="@+id/permission_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Permission Location"
        app:layout_constraintBottom_toTopOf="@+id/add_user_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/permission_contact"
        android:layout_marginTop="5dp"/>


    <!-- Button original -->

    <Button
        android:id="@+id/add_user_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add an user"
        app:layout_constraintTop_toBottomOf="@+id/permission_location"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp"/>

    <!-- RecyclerView pour afficher les utilisateurs -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/user_recycler_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/add_user_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"/>


</androidx.constraintlayout.widget.ConstraintLayout>
